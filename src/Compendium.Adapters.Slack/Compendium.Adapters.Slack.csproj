<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Compendium.Adapters.Slack</AssemblyName>
    <RootNamespace>Compendium.Adapters.Slack</RootNamespace>
    <PackageId>Compendium.Adapters.Slack</PackageId>
    <Description>Slack adapter for the Compendium framework. Implements IMessagingConnector (Compendium.Abstractions.Messaging): Events API url_verification challenge echo, X-Slack-Signature (v0 HMAC-SHA256) inbound verification + event parsing, and outbound sends via chat.postMessage. Credentials supplied per call for multi-tenant hosting.</Description>
    <PackageTags>compendium;adapter;slack;messaging;events-api;chat</PackageTags>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Compendium.Core" />
    <PackageReference Include="Compendium.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Compendium.Abstractions.Messaging\Compendium.Abstractions.Messaging.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Compendium.Adapters.Slack.Tests" />
  </ItemGroup>

</Project>
