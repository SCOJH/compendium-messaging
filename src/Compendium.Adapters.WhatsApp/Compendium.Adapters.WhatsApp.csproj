<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Compendium.Adapters.WhatsApp</AssemblyName>
    <RootNamespace>Compendium.Adapters.WhatsApp</RootNamespace>
    <PackageId>Compendium.Adapters.WhatsApp</PackageId>
    <Description>WhatsApp Cloud API adapter for the Compendium framework. Implements IMessagingConnector (Compendium.Abstractions.Messaging): GET webhook verification (hub.challenge), HMAC-SHA256 (X-Hub-Signature-256) inbound verification + payload parsing, and outbound sends via the Graph API. Credentials supplied per call for multi-tenant hosting.</Description>
    <PackageTags>compendium;adapter;whatsapp;messaging;cloud-api;chat</PackageTags>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Compendium.Core" />
    <PackageReference Include="Compendium.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Compendium.Abstractions.Messaging\Compendium.Abstractions.Messaging.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Compendium.Adapters.WhatsApp.Tests" />
  </ItemGroup>

</Project>
