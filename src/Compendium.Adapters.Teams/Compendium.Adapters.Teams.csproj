<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Compendium.Adapters.Teams</AssemblyName>
    <RootNamespace>Compendium.Adapters.Teams</RootNamespace>
    <PackageId>Compendium.Adapters.Teams</PackageId>
    <Description>Microsoft Teams (Bot Framework) adapter for the Compendium framework. Implements IMessagingConnector (Compendium.Abstractions.Messaging): parses inbound Bot Framework Activity payloads into normalized messages and sends replies via the Bot Connector API after acquiring an AAD client-credentials token. Credentials supplied per call for multi-tenant hosting. NOTE: inbound JWT validation is not performed in v1 (see README).</Description>
    <PackageTags>compendium;adapter;teams;microsoft-teams;bot-framework;messaging;chat</PackageTags>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Compendium.Core" />
    <PackageReference Include="Compendium.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Compendium.Abstractions.Messaging\Compendium.Abstractions.Messaging.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Compendium.Adapters.Teams.Tests" />
  </ItemGroup>

</Project>
